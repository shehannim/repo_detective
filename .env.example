# repo-detective environment configuration
# Copy this file to .env and fill in your values.

# ── LLM (optional) ──────────────────────────────────────────────────────────
# Set this to enable LLM-powered explanations via the Qwen API.
# Without it, the server still works using keyword + graph ranking only.
QWEN_API_KEY=your_qwen_api_key_here

# Which Qwen model to use (default: qwen-max)
# QWEN_MODEL=qwen-max

# ── Tuning ───────────────────────────────────────────────────────────────────
# Number of chars from each file sent to the LLM (default: 3000)
# REPO_DET_CONTENT_CHARS=3000

# How many top candidates to feed to the LLM (default: 5)
# REPO_DET_LLM_TOP_K=5

# LLM request timeout in seconds (default: 30)
# REPO_DET_LLM_TIMEOUT=30
